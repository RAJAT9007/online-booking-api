# ============================================
# DATABASE CONFIGURATION (Neon PostgreSQL)
# ============================================
# Your Neon Cloud Database
SPRING_DATASOURCE_URL=postgresql://neondb_owner:npg_EBfGo3Sja8Ys@ep-empty-cell-at7ectpl-pooler.c-9.us-east-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require
SPRING_DATASOURCE_USERNAME=neondb_owner
