# Hibernate DDL Auto (use 'validate' for production, 'update' for development)
SPRING_JPA_HIBERNATE_DDL_AUTO=validate

# ============================================
# REDIS CONFIGURATION (Caching)
# ============================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ============================================
# RABBITMQ CONFIGURATION (Message Queue)
# ============================================
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest

# ============================================
# SERVER CONFIGURATION
# ============================================
# Application port (Render will auto-set PORT if not provided)
PORT=8082

# ============================================
# STRIPE PAYMENT GATEWAY
# ============================================
# Use test keys for development, live keys for production
STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key_here
STRIPE_SECRET_KEY=sk_test_your_secret_key_here
STRIPE_MOCK=false

# ============================================
# JWT SECURITY
# ============================================
# Generate secure key: openssl rand -base64 32
JWT_SECRET=bXlTZWNyZXRLZXlGb3JUaWNrZXRCb29raW5nQXBpV2l0aEF0TGVhc3QyNTZCaXRzT2ZMZW5ndGhGb3JTZWN1cml0eVNpZ25hdHVyZSE=
JWT_EXPIRATION=3600000

# ============================================
# FRONTEND CONFIGURATION
# ============================================
# Frontend application URL for CORS and redirects
CLIENT_URL=http://localhost:4200
FRONTEND_URL=http://localhost:4200

# ============================================
# ENVIRONMENT PROFILE
# ============================================
# Use 'prod' for production, 'dev' for development
SPRING_PROFILES_ACTIVE=dev

